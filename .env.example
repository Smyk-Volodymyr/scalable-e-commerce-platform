# Скопіюйте у .env і підставте власні значення:
#   cp .env.example .env
#
# docker compose підставляє з цього файлу рівно три змінні — ті, що нижче в
# розділі «Секрети». Решта задана всередині docker-compose.yml для кожного
# контейнера і зібрана тут як довідка: вона знадобиться, якщо запускати окремий
# сервіс локально через `npm run dev` (тоді .env кладеться в каталог сервісу).

# ---------- Секрети: тільки їх читає docker compose ----------

# Мінімум 32 символи — коротший не пройде валідацію схеми оточення.
# Згенерувати: openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# Ключі Stripe. Тестові беруться в дашборді Stripe -> Developers -> API keys.
STRIPE_SECRET_KEY=sk_test_replace_me
# Секрет підпису вебхука: Developers -> Webhooks -> ваш endpoint -> Signing secret.
# Для локальної розробки видається командою `stripe listen`.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# ---------- Довідка: значення задані в docker-compose.yml ----------

# Спільне
# NODE_ENV=production

# user-service
# PORT=3001
# DATABASE_URL=postgres://shop:shop@user-db:5432/user_service
# JWT_EXPIRES_IN=15m          # час життя access-токена
# REFRESH_TTL_DAYS=30         # час життя refresh-токена
# BCRYPT_ROUNDS=12            # вартість хешування пароля, 10–15

# product-service
# PORT=3002
# DATABASE_URL=postgres://shop:shop@product-db:5432/product_service
# RESERVATION_TTL_MINUTES=15  # скільки живе резерв складу до автозвільнення
# RABBITMQ_URL=amqp://shop:shop@rabbitmq:5672

# cart-service
# PORT=3003
# REDIS_URL=redis://cart-redis:6379
# PRODUCT_SERVICE_URL=http://product-service:3002
# CART_TTL_DAYS=30            # скільки Redis тримає покинутий кошик

# order-service
# PORT=3004
# DATABASE_URL=postgres://shop:shop@order-db:5432/order_service
# PRODUCT_SERVICE_URL=http://product-service:3002
# CART_SERVICE_URL=http://cart-service:3003
# RABBITMQ_URL=amqp://shop:shop@rabbitmq:5672

# payment-service
# PORT=3005
# DATABASE_URL=postgres://shop:shop@payment-db:5432/payment_service
# ORDER_SERVICE_URL=http://order-service:3004

# notification-service
# PORT=3006
# DATABASE_URL=postgres://shop:shop@notification-db:5432/notification_service
# RABBITMQ_URL=amqp://shop:shop@rabbitmq:5672

# api-gateway
# PORT=3000
# USER_SERVICE_URL=http://user-service:3001
# PRODUCT_SERVICE_URL=http://product-service:3002
# CART_SERVICE_URL=http://cart-service:3003
# ORDER_SERVICE_URL=http://order-service:3004
# PAYMENT_SERVICE_URL=http://payment-service:3005
# CORS_ORIGIN=http://localhost:5173   # список через кому
